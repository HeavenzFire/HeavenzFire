{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HeavenzFire/HeavenzFire/blob/main/HEAVENZFIRE-CONTRACTS-V1.json",
  "title": "HeavenzFire Shared Contracts v1",
  "description": "Versioned, least-privilege contracts for task requests, tool results, evidence records, and agent manifests. These schemas validate structure; runtime authorization must be enforced separately.",
  "$defs": {
    "RiskTier": {
      "type": "string",
      "enum": [
        "read_only",
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "TaskRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "goal",
        "scope",
        "risk_tier",
        "requested_capabilities",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositories"
          ],
          "properties": {
            "repositories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "maxItems": 100
            },
            "paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "maxItems": 500
            },
            "network_hosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "maxItems": 100
            }
          }
        },
        "risk_tier": {
          "$ref": "#/$defs/RiskTier"
        },
        "requested_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
          },
          "maxItems": 100
        },
        "approval_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "ToolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "tool_id",
        "status",
        "started_at",
        "finished_at",
        "output_truncated"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tool_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "denied",
            "cancelled",
            "timed_out",
            "unavailable",
            "skipped"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "output_excerpt": {
          "type": "string",
          "maxLength": 12000
        },
        "output_truncated": {
          "type": "boolean"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 100
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "EvidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_id",
        "task_id",
        "action",
        "result",
        "timestamp"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "input_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "denied",
            "not_run",
            "inconclusive"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 100
        }
      }
    },
    "AgentManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_id",
        "display_name",
        "capabilities",
        "healthcheck",
        "limits",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
          },
          "maxItems": 100
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
          },
          "maxItems": 100
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "healthcheck": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "http",
                "tcp",
                "process",
                "command",
                "manual"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout_seconds",
            "max_output_bytes",
            "max_tool_calls"
          ],
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 256,
              "maximum": 10485760
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "configured",
            "healthy",
            "degraded",
            "offline",
            "disabled",
            "unknown"
          ]
        }
      }
    }
  }
}
