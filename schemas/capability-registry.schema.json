{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HeavenzFire/HeavenzFire/blob/main/schemas/capability-registry.schema.json",
  "title": "HeavenzFire Capability Registry",
  "type": "object",
  "required": ["schema_version", "components"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["id", "version", "status", "data_classes", "network_access", "permissions", "entrypoints", "tests", "owner", "limitations"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
        "status": { "enum": ["proposed", "implemented", "verified", "deprecated"] },
        "data_classes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "network_access": { "enum": ["none", "allowlisted", "unrestricted"] },
        "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "entrypoints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tests": {
          "type": "object",
          "required": ["command", "last_result"],
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "last_result": { "enum": ["not-run", "passed", "failed"] }
          }
        },
        "owner": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}