{
  "name": "HeavenzFire Unified Field",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.vscode-pull-request-github",
        "GitHub.copilot"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.testing.unittestEnabled": true,
        "python.testing.pytestEnabled": false
      }
    }
  },
  "remoteEnv": {
    "HEAVENZFIRE_ROOT": "${containerWorkspaceFolder}",
    "HEAVENZFIRE_MODE": "codespace-development"
  },
  "postCreateCommand": "python -m unittest discover -s tests -p 'test_*.py' -v",
  "forwardPorts": [8787, 8788, 8790],
  "portsAttributes": {
    "8787": { "label": "HeavenzFire Gateway", "onAutoForward": "notify", "visibility": "private" },
    "8788": { "label": "HeavenzFire Orchestrator", "onAutoForward": "notify", "visibility": "private" },
    "8790": { "label": "HeavenzFire Agent Health", "onAutoForward": "notify", "visibility": "private" }
  },
  "shutdownAction": "stopContainer"
}
