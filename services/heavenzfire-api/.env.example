# Copy into your local environment; never commit real secrets.
# Required for protected endpoints. Use a long random value; rotate if exposed.
HF_API_KEYS=replace-with-a-long-random-token
# Optional Gemini provider key (keep server-side only)
GEMINI_API_KEY=
HF_DEFAULT_MODEL=gemini-2.5-flash
# Local Ollama defaults to loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
HF_LOCAL_MODEL=llama3.2:1b
PORT=18796
HF_HOST=127.0.0.1
HF_MAX_BODY_BYTES=1048576
HF_REQUEST_TIMEOUT_MS=60000
