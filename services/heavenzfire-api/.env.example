# Copy into your local environment; never commit real secrets.
# Required for protected endpoints. Use a long random value; rotate if exposed.
HF_API_KEYS=replace-with-a-long-random-token
# Optional Gemini provider key (keep server-side only)
GEMINI_API_KEY=
HF_DEFAULT_MODEL=gemini-2.5-flash
# Local Ollama defaults to loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
HF_LOCAL_MODEL=llama3.2:1b
PORT=18796
HF_HOST=127.0.0.1
HF_MAX_BODY_BYTES=1048576
HF_REQUEST_TIMEOUT_MS=60000

# Optional hosted providers; keys stay on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Qwen endpoint is region/workspace-specific: set QWEN_BASE_URL from your provider console.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional custom OpenAI-compatible provider (only use a trusted HTTPS endpoint).
HF_CUSTOM_API_KEY=
HF_CUSTOM_API_BASE_URL=
HF_CUSTOM_MODEL=
